<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <!-- Layout for message input (CustomEditText and Send button) -->
    <LinearLayout
        android:id="@+id/layoutMessageInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.example.messager.CustomEditText
            android:id="@+id/customEditTextMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Digite sua mensagem"
            android:imeOptions="actionSend"
            android:maxLines="5"
            android:padding="8dp" />


        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:text="Enviar"
            android:textSize="11sp"
            android:background="@drawable/shape_round_white_button" />
    </LinearLayout>

    <!-- Container for the custom keyboard -->
    <LinearLayout
        android:id="@+id/layoutKeyboardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
